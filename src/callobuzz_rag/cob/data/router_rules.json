    "\\bhow (do|can|should|would|to|does)\\b",
    "\\bwhat (is|are) (a|an)\\b",
    "\\bwhat does\\b",
    "\\bexplain\\b",
    "\\bdifference between\\b",
    "\\bsteps? to\\b",
    "\\btell me about\\b",
    "\\bwhy (do|does|should)\\b",
    "\\bkaise\\b",
    "\\bkya hota hai\\b",
    "कैसे",
    "क्या होता है"
  ],
  "possessives": [
    "\\b(my|our|mine)\\b",
    "\\bmer[aei]\\b",
    "\\bhamar[aei]\\b",
    "मेरा|मेरी|मेरे|हमारा|हमारी|हमारे"
