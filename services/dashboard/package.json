{
	"name": "cob-rag-dashboard",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test",
		"gen:api": "openapi-typescript ../../docs/openapi.json -o src/lib/api/schema.d.ts",
		"gen:api:check": "node scripts/gen-api-check.mjs",
		"build:landing": "node --experimental-strip-types landing/fonts.ts && vite build --config landing/vite.landing.config.ts",
		"e2e:landing": "playwright test e2e/landing"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/inter-tight": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/noto-sans-devanagari": "^5.3.0",
		"@fontsource-variable/noto-serif-devanagari": "^5.3.0",
		"@fontsource/hind": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/mukta": "^5.3.0",
		"@fontsource/red-hat-text": "^5.3.0",
		"@fontsource/schibsted-grotesk": "^5.3.0",
		"@hookform/resolvers": "^5.9.1",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-router": "^1.170.40",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"input-otp": "^1.5.0",
		"lucide-react": "^1.49.0",
		"openapi-fetch": "^0.17.0",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.89.0",
		"recharts": "^3.10.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.41",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.1.1",
		"msw": "^2.15.0",
		"openapi-typescript": "^7.13.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.9.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	},
	"pnpm": {
		"overrides": {
			"seroval": "^1.6.11",
			"undici": "^8.12.2",
			"source-map-js": "^1.2.2"
		}
	}
}
