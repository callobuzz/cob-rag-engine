# Callobuzz RAG Engine: configuration template
#
# Do not edit this by hand. Run `make setup` (or `python scripts/setup.py`): it asks a few
# questions, generates every secret and writes your `.env` in this same layout.
#
# How values are read: one `KEY=value` per line, no spaces around `=`, comments on their own
# line. Docker Compose and the engine both read `.env` at the repo root. To edit by hand
# instead: `cp .env.example .env`, then `python scripts/generate_secrets.py` fills the secrets.
#
# Never put a comment after an EMPTY value (`KEY=   # note`): Compose and python-dotenv both
# read that as the value "# note". Comment the line above.
#
# Addresses a process on THIS machine uses (`make dev-app`, pytest) say 127.0.0.1, never
# `localhost`: on Windows with Docker Desktop `localhost` resolves to IPv6 ::1 first and the
# connection resets, which looks exactly like the service being down. Containers get service
# names (postgres, redis, ...) from docker-compose.yml, which wins over this file; to point a
# container at something elsewhere use the matching `*_CONTAINER` variable in Advanced.
#
# Lines marked PRODUCTION must change before you expose a deployment to the internet.
#
# Sections: 1 Required, 2 Email, 3 Embeddings, 4 Re-ranker, 5 Storage, 6 Dashboard,
#           7 Ports and network, 8 Optional services, 9 Advanced.


# ==============================================================================
# 1. REQUIRED: fill these in
# ==============================================================================

# Your e-mail. The first start creates the super-admin account and sends (or prints) a link to set its password. A real address; .local, .test, .example, .localhost and .invalid (which never receive mail) are accepted only while RAG_ENV=dev and refused in production.
RAG_SUPERADMIN_EMAIL=

# Which company answers questions: openrouter | openai | anthropic | gemini | ollama (any LiteLLM provider id).
RAG_LLM_PROVIDER=openrouter
# The model that writes the answers, in the provider's own naming (e.g. gpt-6.1-sol, claude-sonnet-5-5, gemini-3.8-flash). The default, openai/gpt-oss-120b on OpenRouter, is the best English answer model in the answer benchmark (benchmarks/README.md); it cannot switch thinking off, so RAG_LLM_THINKING below keeps it at "low".
RAG_LLM_MODEL=openai/gpt-oss-120b
# Your API key for that provider. Empty: answers fail until a key is set here, on the corpus or per request.
RAG_LLM_API_KEY=
# The fast model: a small, quick model from the same provider that rewrites the search question and does other helper work (e.g. openai/gpt-6-luna, the measured pick: the highest business-question recall and accuracy of the models that pass every label-benchmark bar, about 1.9 s p90, 98.9% accurate; budget option: google/gemma-4-26b-a4b-it, 64% cheaper and 97.7% accurate; see benchmarks/README.md; claude-haiku-4-5, gemini-3.5-flash-lite). Use a small non-thinking model here: it labels every message and suggests follow-ups; a thinking model makes replies slow. Empty = the main model does it, at RAG_LLM_FAST_THINKING (a warning in the log says so once when it is a thinking model).
RAG_LLM_FAST_MODEL=openai/gpt-6-luna
# OpenRouter only: the hosts to try first for the fast model, as OpenRouter provider slugs (e.g. groq,cerebras). The same model can be several times faster on one host than another; the "Fast models" table in benchmarks/README.md lists the measured pins. Fallbacks stay allowed. Empty = OpenRouter chooses.
RAG_LLM_FAST_PROVIDER_ORDER=
# Answer model per reply language, as JSON (OpenRouter example). Hindi and Hinglish replies use Gemma 4 31B (the best Hindi tone and the fastest first word in the answer benchmark, see benchmarks/README.md); English and every language not listed use RAG_LLM_MODEL. Use model ids of RAG_LLM_PROVIDER. A knowledge base overrides it (llm_config.language_models, {} = off). Empty = no routing. These ids are OpenRouter's: if you change RAG_LLM_PROVIDER, change or clear this line (the setup wizard does).
RAG_LLM_LANGUAGE_MODELS={"hi":"google/gemma-4-31b-it","hi-Latn":"google/gemma-4-31b-it"}
# Only for a self-hosted endpoint such as Ollama. From a container use host.docker.internal, not 127.0.0.1.
# RAG_LLM_API_BASE=http://host.docker.internal:11434

# Secrets below are generated by `make setup` (or scripts/generate_secrets.py). Keep a copy of
# RAG_ENCRYPTION_KEY: without it the stored per-corpus LLM keys cannot be read.

# Master admin API key: creates tenants and corpora. Keep it server-side; never put it in a browser.
RAG_ADMIN_API_KEY=
# Signs dashboard sign-ins (comma-separated list, each 32+ characters; rotate as <new>,<old>). Empty turns sign-in off.
RAG_SESSION_SECRET=
# Fernet key that encrypts per-corpus LLM keys at rest (comma-separated list, primary first, to rotate).
RAG_ENCRYPTION_KEY=
# Postgres password. Only read when the database is first created; changing it later needs ALTER USER.
RAG_DB_PASSWORD=
# Valkey (a Redis-compatible store) password. It ships with no auth; this stops anyone on the network from wiping it.
RAG_REDIS_PASSWORD=
# Qdrant API key. Qdrant ships with no auth and holds every embedding.
RAG_QDRANT_API_KEY=


# ==============================================================================
# 2. Email (SMTP)
# ==============================================================================
# Sends sign-in codes, invitations and notices. Test it with POST /api/v1/admin/smtp/test.
#   Gmail:  RAG_SMTP_HOST=smtp.gmail.com  RAG_SMTP_PORT=587  RAG_SMTP_SECURITY=starttls,
#           RAG_SMTP_USERNAME=you@gmail.com  RAG_SMTP_PASSWORD=<16-character app password>
#           (Google account > Security > 2-step verification on > App passwords)
#   Amazon SES: host email-smtp.<region>.amazonaws.com, port 587, SMTP credentials from the SES console.
#   Local relay (Mailpit: port 1025, UI on 8025): host host.docker.internal, security none.

# auto | smtp | log | disabled. auto = smtp if a host is set, else `log` in dev (codes go to the mailer log: `docker compose logs mailer`) and `disabled` in prod.
RAG_EMAIL_PROVIDER=auto
# SMTP server. Empty = no SMTP. From a container, a relay on this machine is host.docker.internal.
RAG_SMTP_HOST=
# SMTP port: 587 (STARTTLS), 465 (SSL) or 25 (plain relay).
RAG_SMTP_PORT=587
# starttls | ssl | none. none is only for a relay on the same machine or a private network.
RAG_SMTP_SECURITY=starttls
# SMTP login. Empty = no login (e.g. a local relay).
RAG_SMTP_USERNAME=
# SMTP password (Gmail: the app password, not your normal one).
RAG_SMTP_PASSWORD=
# Sender shown to recipients, required for SMTP: "Your Product <no-reply@yourcompany.in>".
RAG_SMTP_FROM=


# ==============================================================================
# 3. Embeddings (how documents are turned into searchable vectors)
# ==============================================================================
# The default is the bundled TEI container on CPU (the `tei` profile in COMPOSE_PROFILES, section 8). Changing the model on a corpus that
# already has vectors needs a re-embed migration, and the dimensions must match the model.

# tei (bundled container) | local (in-process) | litellm (OpenAI, Cohere, Voyage, Mistral, Gemini, Ollama...) | jina
RAG_EMBEDDING_PROVIDER=tei
# The model name: a Hugging Face id for tei/local, a LiteLLM id for litellm (e.g. openai/text-embedding-3-small).
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# Vector size of that model (1024 for bge-m3, 768 for bge-base-en, 1536 for text-embedding-3-small).
RAG_EMBEDDING_DIMENSIONS=1024
# The model the bundled tei container downloads and serves. Keep it equal to RAG_EMBEDDING_MODEL.
RAG_TEI_MODEL_ID=BAAI/bge-m3
# Where this machine reaches TEI. Containers use http://tei:8080 automatically.
RAG_TEI_URL=http://127.0.0.1:8081
# NVIDIA GPU image for tei (see docker-compose.gpu.yml): cuda-1.9 works on any card; 86-1.9 Ampere, 89-1.9 Ada, 120-1.9 Blackwell.
# RAG_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cuda-1.9
# Your key for hosted embeddings (RAG_EMBEDDING_PROVIDER=litellm).
RAG_EMBEDDING_API_KEY=
# Base URL for a self-hosted embeddings endpoint such as Ollama (litellm provider only).
# RAG_EMBEDDING_API_BASE=http://127.0.0.1:11434
# Your key for Jina (RAG_EMBEDDING_PROVIDER=jina).
RAG_JINA_API_KEY=


# ==============================================================================
# 4. Re-ranker (a second pass that reorders the top search results)
# ==============================================================================
# Off by default: on six test sets it helped two and hurt four (benchmarks/README.md).
# Worth trying for question-and-answer content, ideally on a GPU. Each corpus can override it.

# true | false. Re-rank results for knowledge bases that do not set their own choice. Also what lets the Standard and Premium presets turn re-ranking on without a GPU: a preset leaves it off on a machine without a GPU unless this is true or RAG_RERANK_PROVIDER=llm.
RAG_RERANKING_ENABLED=false
# local = built-in model (free; about 0.4 s a query on GPU, about 10 s on CPU) | llm = your LLM ranks (small cost per query).
RAG_RERANK_PROVIDER=local
# The model used when RAG_RERANK_PROVIDER=llm, in the same provider as RAG_LLM_PROVIDER.
RAG_RERANK_LLM_MODEL=openai/gpt-oss-20b
# The Hugging Face model used when RAG_RERANK_PROVIDER=local (about 2.3 GB, downloaded on first use).
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3


# ==============================================================================
# 5. Storage (where uploaded files are kept: a folder on this server, or any S3-compatible service)
# ==============================================================================
# local | s3. `local` keeps files in a folder on this server (Docker: the `files` volume); nothing
# else to run. Use `s3` for a managed service or when several servers share the files.
RAG_STORAGE_PROVIDER=local
# Folder for `local`. Native runs use data/files under the project; Docker Compose sets its own.
# RAG_STORAGE_LOCAL_ROOT=data/files
# Bucket name (also the folder name under the files folder for `local`).
RAG_S3_BUCKET=rag-documents

# Only when RAG_STORAGE_PROVIDER=s3: any S3-compatible service (Cloudflare R2, AWS S3, Supabase,
# Backblaze B2, DigitalOcean Spaces, or an S3 server you run yourself). Set the endpoint and keys,
# and RAG_S3_ENDPOINT_CONTAINER to the same address:
#   R2:       endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto
#   AWS S3:   leave the endpoint empty, region <REGION>, addressing virtual
#   Supabase: endpoint https://<PROJECT>.supabase.co/storage/v1/s3, addressing path
#   B2 / Vultr / DO Spaces: addressing path
# Move existing files into the folder (or back) with:
#   python -m callobuzz_rag.storage.copy --from s3 --to local --apply
# Where this machine reaches the S3 service.
# RAG_S3_ENDPOINT=
# Where the containers reach it.
# RAG_S3_ENDPOINT_CONTAINER=
# Access key and secret key of your S3 service.
# RAG_S3_ACCESS_KEY=
# RAG_S3_SECRET_KEY=
# Region: R2 needs `auto`; AWS needs the bucket's real region.
# RAG_S3_REGION=us-east-1
# path | virtual | auto. Leave auto unless your provider serves only one style.
# RAG_S3_ADDRESSING_STYLE=auto
# true | false. Create the bucket on start if it is missing. Usually false with a scoped cloud key.
# RAG_S3_AUTO_CREATE_BUCKET=false


# ==============================================================================
# 6. Dashboard (the web app on port 8090)
# ==============================================================================
# The host ports are RAG_APP_HOST_PORT, RAG_SCRAPER_HOST_PORT and RAG_DASHBOARD_HOST_PORT (section 7);
# if you change one, change the matching address below to the same port.

# Base of every link in e-mails (sign in, reset, invitation). PRODUCTION: the dashboard's public HTTPS address.
RAG_DASHBOARD_URL=http://127.0.0.1:8090
# Where the BROWSER reaches the engine (never a compose service name). PRODUCTION: the engine's public HTTPS address.
RAG_DASHBOARD_ENGINE_URL=http://127.0.0.1:8000
# Where the BROWSER reaches the scraper. PRODUCTION: the scraper's public HTTPS address.
RAG_DASHBOARD_SCRAPER_URL=http://127.0.0.1:8001
# Display-only exchange rate for the dashboard's rupee / dollar toggle (amounts are labelled "estimate").
RAG_DASHBOARD_USD_TO_INR=85


# ==============================================================================
# 7. Ports and network
# ==============================================================================

# dev | prod. prod hides /docs, refuses a wildcard CORS list and refuses the `log` e-mail provider. PRODUCTION: prod
RAG_ENV=dev
# Network interface every published port binds to. Keep 127.0.0.1: 0.0.0.0 exposes Postgres, Valkey and Qdrant, and UFW does not stop it.
RAG_BIND_ADDR=127.0.0.1
# Host port of the engine API (the port inside its container stays 8000).
RAG_APP_HOST_PORT=8000
# Host port of the web scraper.
RAG_SCRAPER_HOST_PORT=8001
# Host port of the dashboard.
RAG_DASHBOARD_HOST_PORT=8090
# Where browsers reach this engine, e.g. https://rag.yourcompany.in (used in the widget embed snippet). Empty = the request's own URL.
RAG_PUBLIC_URL=
# Largest video (MB) the public website editor accepts.
# RAG_LANDING_VIDEO_MAX_MB=25
# Largest logo or poster picture (MB) the editor accepts, before it is re-encoded.
# RAG_LANDING_IMAGE_MAX_MB=5
# Folder for the website's published media. Empty = landing-cache under RAG_STORAGE_LOCAL_ROOT.
# RAG_LANDING_CACHE_DIR=
# Website contact form: messages one visitor address may send per hour.
# RAG_LANDING_CONTACT_PER_IP_PER_HOUR=3
# Website contact form: messages the whole site accepts per day.
# RAG_LANDING_CONTACT_PER_DAY=200
# Days a closed website enquiry is kept before it is deleted.
# RAG_LANDING_CONTACT_KEEP_DAYS=365
# L4 install
# The one public web address of this install, for example chat.sharmafurniture.in (a name you own, no scheme, no port). One address serves the dashboard, the engine and the crawler. deploy/install.sh and scripts/setup.py set it and switch on the `proxy` service.
RAG_SITE_DOMAIN=
# E-mail the certificate authority writes to before a certificate expires. Empty = the wizard copies RAG_SUPERADMIN_EMAIL.
RAG_ACME_EMAIL=
# Interface the front door's ports 80 and 443 bind to. The one deliberate exception to RAG_BIND_ADDR.
# RAG_PROXY_BIND_ADDR=0.0.0.0
# The front door's image.
# RAG_CADDY_IMAGE=caddy:2.10-alpine
# /L4 install
# Browser origins allowed to call the engine directly (JSON list). The dashboard's origin must be here. prod refuses ["*"].
RAG_CORS_ORIGINS=["http://127.0.0.1:8090","http://localhost:8090","http://127.0.0.1:8091","http://localhost:8091"]
# Browser origins allowed to call the scraper directly (JSON list). Must include the dashboard's origin.
SCRAPER_CORS_ORIGINS=["http://127.0.0.1:8090","http://localhost:8090","http://127.0.0.1:8091","http://localhost:8091","http://127.0.0.1:5173"]
# true | false. Trust X-Forwarded-For for every per-IP decision (widget, sign-in and sign-up limits, sessions, audit log). Only behind a reverse proxy you control that APPENDS to the header; otherwise anyone can fake their address. The old name RAG_WIDGET_TRUST_PROXY_HEADERS still works.
# RAG_TRUST_PROXY_HEADERS=false
# How many reverse proxies sit in front of the engine (nginx alone = 1, a CDN plus nginx = 2). The caller's address is the X-Forwarded-For entry that many places from the right; entries before it are written by the caller and ignored. 1 to 10.
RAG_TRUSTED_PROXY_HOPS=1
# Interface the API server listens on inside its container. Leave it.
RAG_API_HOST=0.0.0.0
# Port the API server listens on inside its container. Leave it.
RAG_API_PORT=8000


# ==============================================================================
# 8. Optional services (off until you ask for them)
# ==============================================================================
# Profiles start extra containers. Comma-separated:
#   tei               the bundled embedding container (drop it when RAG_EMBEDDING_PROVIDER is not tei)
#   observability     self-hosted Langfuse with its own Postgres, UI on http://127.0.0.1:3002
#   transcription     Whisper, for ingesting audio files (mp3, wav, m4a, ogg)
#   legacy-dashboard  the previous dashboard on :8091 (removed in the next release)
#   proxy             Caddy, the one front door with automatic HTTPS for RAG_SITE_DOMAIN (ports 80 and 443)

# Which optional containers start.
COMPOSE_PROFILES=tei

# Audio transcription. whisper_local needs the `transcription` profile; whisper_api uses OpenAI. off | whisper_api | whisper_local
RAG_TRANSCRIPTION_PROVIDER=off
# OpenAI key for RAG_TRANSCRIPTION_PROVIDER=whisper_api.
RAG_WHISPER_API_KEY=
# Model for whisper_api.
RAG_WHISPER_MODEL=whisper-1
# Where this machine reaches the Whisper container. Containers use http://whisper:9000 automatically.
RAG_WHISPER_LOCAL_URL=http://127.0.0.1:9010
# Whisper model size for whisper_local: tiny | base | small | medium | large.
RAG_WHISPER_LOCAL_MODEL=base
# Host port the Whisper container publishes.
# RAG_WHISPER_HOST_PORT=9010
# Whisper container image (CPU) and its GPU variant.
# RAG_WHISPER_IMAGE=onerahmet/openai-whisper-asr-webservice:v1.9.1
# RAG_WHISPER_GPU_IMAGE=onerahmet/openai-whisper-asr-webservice:v1.9.1-gpu

# Observability (Langfuse): start the profile, open http://127.0.0.1:3002, create a project,
# paste its keys below and set RAG_LANGFUSE_ENABLED=true.
# true | false. Send traces to Langfuse.
RAG_LANGFUSE_ENABLED=false
# Langfuse project public key (from the Langfuse UI).
RAG_LANGFUSE_PUBLIC_KEY=
# Langfuse project secret key (from the Langfuse UI).
RAG_LANGFUSE_SECRET_KEY=
# Where this machine reaches Langfuse. Containers use http://langfuse:3000 automatically.
RAG_LANGFUSE_HOST=http://127.0.0.1:3002
# Password of Langfuse's own database (generated by `make setup`). Changing it signs you out.
RAG_LANGFUSE_DB_PASSWORD=
# Keys the hashing of stored Langfuse API keys (generated). Changing it invalidates existing keys.
RAG_LANGFUSE_NEXTAUTH_SECRET=
# Salt for Langfuse API keys (generated). Changing it invalidates existing keys.
RAG_LANGFUSE_SALT=
# Where a browser reaches the Langfuse UI.
# RAG_LANGFUSE_URL=http://localhost:3002


# ==============================================================================
# 9. Advanced: safe defaults, change only if you know why
# ==============================================================================

# --- Application and logging ---
# Name shown in logs and metrics.
RAG_APP_NAME=cob-rag-engine
# true | false. DEBUG logs are large and include document text.
RAG_DEBUG=false
# DEBUG | INFO | WARNING | ERROR.
RAG_LOG_LEVEL=INFO
# true | false. Log every SQL statement with its parameters (document text included).
RAG_DB_ECHO=false
# API server processes. Each loads its own models (about 3 GB of VRAM each on a GPU box).
RAG_API_WORKERS=1
# Ingest jobs run in parallel by the worker. Keep 1 with in-process GPU embeddings (provider local).
RAG_WORKER_CONCURRENCY=2
# OCR for scanned pages: rapidocr | tesseract | paddleocr | off. For Hindi and other Indic
# scans use paddleocr (pip install -e ".[ocr-paddle]") or tesseract.
RAG_OCR_ENGINE=rapidocr
# Languages OCR reads, comma list in preference order: en | hi,en | hi,en,mr (en hi mr ne sa ta te kn
# bn gu ml pa or as ur; paddleocr and rapidocr cover the first eight).
RAG_OCR_LANGS=en
# Build-time, Docker only (docker-compose.yml passes it as the INSTALL_EVAL build arg): true puts
# the answer-quality evaluation add-on (RAGAS, which brings LangChain; about 150 MB) in the image
# at `docker compose build`. false: no LangChain, no RAGAS. Native: pip install -e ".[eval]".
RAG_INSTALL_EVAL=false

# --- Datastore addresses, as this machine sees them (containers get service names) ---
# Postgres host.
RAG_DB_HOST=127.0.0.1
# Postgres published port.
RAG_DB_PORT=5433
# Postgres user (the containers always use rag).
RAG_DB_USER=rag
# Postgres database name (the containers always use rag_kernel).
RAG_DB_NAME=rag_kernel
# Valkey (a Redis-compatible store) host. The RAG_REDIS_* names are kept on purpose.
RAG_REDIS_HOST=127.0.0.1
# Valkey published port.
RAG_REDIS_PORT=6380
# Valkey database number (the job queue's results use the next one).
RAG_REDIS_DB=0
# Qdrant host.
RAG_QDRANT_HOST=127.0.0.1
# Qdrant REST port.
RAG_QDRANT_PORT=6333
# Qdrant collection used for the default corpus.
RAG_QDRANT_COLLECTION=chunks

# --- Datastore addresses for the containers (point them at something outside compose) ---
# Postgres host for containers, e.g. 10.0.0.5.
# RAG_DB_HOST_CONTAINER=postgres
# Postgres port for containers.
# RAG_DB_PORT_CONTAINER=5432
# Valkey host for containers (the compose service is `valkey`; `redis` is kept as its alias).
# RAG_REDIS_HOST_CONTAINER=valkey
# Valkey port for containers.
# RAG_REDIS_PORT_CONTAINER=6379
# Valkey image override (default valkey/valkey:8.1-alpine, BSD-3-Clause).
# RAG_VALKEY_IMAGE=valkey/valkey:8.1-alpine
# Qdrant host for containers.
# RAG_QDRANT_HOST_CONTAINER=qdrant
# Qdrant port for containers.
# RAG_QDRANT_PORT_CONTAINER=6333
# TEI address for containers.
# RAG_TEI_URL_CONTAINER=http://tei:8080
# Langfuse address for containers.
# RAG_LANGFUSE_HOST_CONTAINER=http://langfuse:3000
# Whisper address for containers.
# RAG_WHISPER_LOCAL_URL_CONTAINER=http://whisper:9000

# --- Embedding tuning ---
# Instruction put before each query; unset = the model's own convention, empty = none.
# RAG_EMBEDDING_QUERY_PREFIX=
# Instruction put before each passage; changing it needs a re-embed.
# RAG_EMBEDDING_PASSAGE_PREFIX=
# Texts per call for the litellm and local providers.
# RAG_EMBEDDING_BATCH_SIZE=64
# true | false. Half precision for provider local on a GPU: about 3x faster, near-identical vectors.
# RAG_EMBEDDING_FP16=true
# Inputs per TEI request; must be at most TEI's max_client_batch_size.
RAG_TEI_BATCH_SIZE=32
# TEI requests in flight per ingest batch.
RAG_TEI_CONCURRENCY=4
# Jina model (provider jina only).
RAG_JINA_MODEL=jina-embeddings-v3
# Jina vector size.
RAG_JINA_DIMENSIONS=1024
# Texts per Jina call.
RAG_JINA_BATCH_SIZE=64
# Seconds a query's embedding is cached.
RAG_QUERY_EMBEDDING_CACHE_TTL=3600

# --- Chunking ---
# Aimed-for chunk size in tokens.
RAG_CHUNK_TARGET_TOKENS=300
# Smaller chunks are merged into a neighbour.
RAG_CHUNK_MIN_TOKENS=50
# Larger chunks are split.
RAG_CHUNK_MAX_TOKENS=1000
# Tokens repeated between neighbouring chunks.
RAG_CHUNK_OVERLAP_TOKENS=64

# --- Upload and document size limits ---
# Largest file one upload may be, in bytes (default 50 MB). A plan can set a lower limit per tenant.
RAG_MAX_UPLOAD_BYTES=52428800
# Most text one document may hold, in tokens, counted after parsing: a 5 MB PDF is fine if the text inside is small. A plan can set a lower limit.
RAG_MAX_DOCUMENT_TOKENS=500000

# --- LLM tuning ---
# Answer randomness, 0 to 1.
RAG_LLM_TEMPERATURE=0.7
# Maximum tokens in an answer.
RAG_LLM_MAX_TOKENS=2048
# Randomness of the fast model (query understanding); 0 is right.
# RAG_LLM_FAST_TEMPERATURE=0.0
# Token cap for the fast model, applied only to models known not to reason.
# RAG_LLM_FAST_MAX_TOKENS=512
# Thinking of the answer model: off | minimal | low | medium | high | provider-default. Off is fastest and cheapest; turn it on only for hard questions. Each model family is switched its own way; one that cannot switch thinking off (gpt-oss, Gemini 3 Flash) gets its minimum, and answers report what it ran at (thinking_effective). Empty = RAG_LLM_REASONING_EFFORT if set, else the provider's default. Each knowledge base can set its own. Ships as low, the level gpt-oss-120b runs at; clear it (or set the level you want) when you change the model.
RAG_LLM_THINKING=low
# Thinking of the fast model's helper calls (labels, search rewrites, follow-up chips). Same values; off unless you have a reason.
RAG_LLM_FAST_THINKING=off
# Older name of RAG_LLM_THINKING (none = off), still read when RAG_LLM_THINKING is empty.
# RAG_LLM_REASONING_EFFORT=
# Seconds an LLM call may take before it fails.
# RAG_LLM_TIMEOUT_SECONDS=120
# The same for query understanding, which a query can do without.
# RAG_LLM_FAST_TIMEOUT_SECONDS=30
# Rupees per US dollar, used to show costs in rupees (costs are recorded in dollars). A fixed
# number you set; the engine makes no exchange-rate calls.
# RAG_USD_INR_RATE=84.0
# With an OpenRouter engine key, the header warns when the remaining balance is under this many dollars.
# RAG_OPENROUTER_LOW_BALANCE_USD=5

# --- Retrieval ---
# Candidates fetched by dense (meaning) search.
RAG_RETRIEVAL_TOP_K_DENSE=20
# Candidates fetched by keyword (BM25) search.
RAG_RETRIEVAL_TOP_K_SPARSE=20
# RRF constant, used when RAG_FUSION_STRATEGY=rrf.
RAG_RRF_K=60
# convex (measured best) | rrf. How the dense and keyword results are combined.
RAG_FUSION_STRATEGY=convex
# Share of the dense score in convex fusion, 0 to 1.
RAG_HYBRID_DENSE_WEIGHT=0.75
# true | false. Search by meaning and by keyword together; the keyword leg finds exact codes and SKUs.
RAG_HYBRID_SEARCH_ENABLED=true
# Keyword analyzer language (a Snowball language, or none for code and mixed-language content). Changing it needs a reindex.
RAG_SPARSE_LANGUAGE=english
# BM25 k1. Changing it needs a reindex.
# RAG_SPARSE_BM25_K1=1.2
# BM25 b. Changing it needs a reindex.
# RAG_SPARSE_BM25_B=0.75
# Average chunk length in index terms that BM25 normalises against.
# RAG_SPARSE_AVG_DOC_TOKENS=128
# true | false. Index each chunk with its heading path in front. Re-embed after changing it.
RAG_INDEX_HEADING_CONTEXT=true
# true | false. Keep the order the pipeline decided instead of the fusion order (measured worse with the default reranker).
RAG_PIPELINE_ORDER_ENABLED=false

# --- Re-ranker tuning ---
# Candidates sent to the re-ranker.
RAG_RERANK_TOP_N_INPUT=50
# Results kept after re-ranking.
RAG_RERANK_TOP_K_OUTPUT=10
# Pairs per batch; 0 = auto (1 on CPU, 8 on GPU).
RAG_RERANK_BATCH_SIZE=0
# Maximum tokens per question and chunk pair.
RAG_RERANK_MAX_LENGTH=1024
# true | false. Half precision on GPU: about 3.5x faster, same top 10.
RAG_RERANK_FP16=true
# true | false. Load the built-in re-ranker in the background at start instead of on first use. Unset = load it when re-ranking is on for the engine or any knowledge base uses it.
# RAG_RERANK_WARMUP_ENABLED=

# --- Diversity and freshness ---
# true | false. Drop near-duplicate results (MMR).
RAG_MMR_ENABLED=true
# MMR balance: 1 = relevance only, 0 = diversity only.
RAG_MMR_LAMBDA=0.7
# true | false. Prefer newer documents.
RAG_TEMPORAL_DECAY_ENABLED=true
# Days after which a document's weight halves.
RAG_TEMPORAL_DECAY_HALF_LIFE_DAYS=30.0

# --- Answer context ---
# Tokens of retrieved text given to the LLM.
RAG_CONTEXT_MAX_TOKENS=4096
# Tokens kept free for the answer.
RAG_RESPONSE_RESERVE_TOKENS=1024

# --- Safety and answer checking ---
# true | false. Log prompt-injection-looking input.
RAG_SAFETY_LOG_SUSPICIOUS=true
# true | false. Check each answer for support in the sources.
RAG_VALIDATION_ENABLED=true
# Confidence below which an answer is flagged, 0 to 1.
RAG_VALIDATION_CONFIDENCE_THRESHOLD=0.7
# Weight of the gatekeeper check.
RAG_VALIDATION_GATEKEEPER_WEIGHT=0.4
# Weight of the auditor check.
RAG_VALIDATION_AUDITOR_WEIGHT=0.4
# Weight of the strategist check.
RAG_VALIDATION_STRATEGIST_WEIGHT=0.2

# --- Query understanding and pipeline ---
# true | false. HyDE: search with a hypothetical answer (extra LLM call).
RAG_HYDE_ENABLED=false
# Rephrasings generated per query.
RAG_MULTI_QUERY_COUNT=3
# true | false. Classify each query before searching.
RAG_QUERY_CLASSIFICATION_ENABLED=true
# Candidates kept from search.
RAG_QUERY_TOP_K=20
# Chunks given to the LLM.
RAG_QUERY_FINAL_K=5
# Reserved for retry-on-validation-failure.
RAG_QUERY_MAX_RETRIES=1
# true | false. Enables POST /api/v1/query/stream.
RAG_QUERY_STREAM_ENABLED=true

# --- Webhooks ---
# Seconds per webhook call.
RAG_WEBHOOK_TIMEOUT=10
# Retry attempts on failure.
RAG_WEBHOOK_MAX_RETRIES=3
# Seconds between retries (base).
RAG_WEBHOOK_RETRY_DELAY=60

# --- Scheduled jobs (Celery Beat, cron syntax) ---
# Weekly evaluation run, Sunday 03:00.
RAG_EVAL_SCHEDULE_CRON=0 3 * * 0
# Traces per evaluation run.
RAG_EVAL_BATCH_SIZE=50
# true | false. Run an evaluation when a corpus config changes.
RAG_EVAL_AUTO_TRIGGER=true
# Weekly knowledge-gap detection, Monday 04:00.
RAG_GAP_DETECTION_SCHEDULE_CRON=0 4 * * 1
# Smallest group of similar unanswered questions that counts as a gap.
RAG_GAP_MIN_CLUSTER_SIZE=5
# Answers below this confidence count as unanswered, 0 to 1.
RAG_GAP_CONFIDENCE_THRESHOLD=0.5
# Weekly auto-optimiser, Sunday 05:00.
RAG_OPTIMIZER_SCHEDULE_CRON=0 5 * * 0
# true | false. Let the optimiser change retrieval settings on its own.
RAG_OPTIMIZER_ENABLED=false
# Trials per optimiser run.
RAG_OPTIMIZER_N_TRIALS=50

# --- Re-ingestion and embedding migration ---
# Days before a pending review expires.
RAG_REVIEW_EXPIRY_DAYS=7

# --- Smart ingestion ---
# Strip page furniture (menus, footers, cookie notices, repeated disclaimers) before chunking.
RAG_BOILERPLATE_STRIP_ENABLED=true
# A paragraph already in this many other documents of the knowledge base is dropped.
RAG_BOILERPLATE_MIN_DOCS=3
# Longest paragraph (characters) that counts as repeated furniture; longer repeats are left alone.
RAG_BOILERPLATE_MAX_CHARS=600
# Lowest cosine similarity at which an existing document counts as a near-duplicate of an upload.
RAG_SIMILARITY_MIN_SCORE=0.90
# Return a passage stored in several documents once, with the others listed as "also in".
RAG_COLLAPSE_DUPLICATES=true
# Chunks re-embedded per batch during a migration.
RAG_MIGRATION_BATCH_SIZE=128
# Migrations running at once.
RAG_MIGRATION_MAX_CONCURRENT=2
# Days the old collection is kept after a migration, for rollback.
RAG_MIGRATION_RETENTION_DAYS=7
# Seconds a migration waits for in-flight writes to drain.
RAG_MIGRATION_DRAIN_TIMEOUT_SECONDS=1800
# Daily check for an embedding model that drifted from the corpus, 02:00.
RAG_EMBEDDING_DRIFT_SCHEDULE_CRON=0 2 * * *
# Daily removal of expired migration collections, 03:00.
RAG_MIGRATION_PRUNE_SCHEDULE_CRON=0 3 * * *

# --- Email tuning ---
# Seconds one SMTP operation (connect, each command) may take.
RAG_SMTP_TIMEOUT_SECONDS=20

# --- Sign-in sessions ---
# Access-token lifetime in minutes (1 to 60).
RAG_ACCESS_TOKEN_MINUTES=15
# A sign-in lasts this many days without use (1 to 90); each refresh extends it.
RAG_REFRESH_TOKEN_DAYS=30
# A sign-in never lasts longer than this many days (1 to 365).
RAG_SESSION_MAX_DAYS=90

# --- Content Portal (pre-ingestion AI structuring and review) ---
# true | false. Turn the Content Portal on.
RAG_ENABLE_CONTENT_PORTAL=true
# Largest workspace in MB.
RAG_PORTAL_MAX_WORKSPACE_SIZE_MB=100
# single_reviewer | maker_checker.
RAG_PORTAL_DEFAULT_WORKFLOW=single_reviewer
# Minutes a chunk stays locked for editing.
RAG_PORTAL_LOCK_TIMEOUT_MINUTES=30
# true | false. Start a review automatically after ingest.
RAG_PORTAL_AUTO_REVIEW_AFTER_INGEST=false
# Token budget for one AI transform.
RAG_PORTAL_AI_MAX_TOKENS_PER_TRANSFORM=100000
# Model for AI transforms; empty = the corpus's LLM.
RAG_PORTAL_AI_DEFAULT_MODEL=

# --- Conversations and memory ---
# summary | semantic. How long conversations are remembered.
RAG_MEMORY_MODE=summary
# Messages before older ones are summarised.
RAG_MEMORY_SUMMARY_THRESHOLD=10
# Most memory entries kept.
RAG_MEMORY_MAX_ENTRIES=10000
# Days a memory entry is kept.
RAG_MEMORY_TTL_DAYS=90
# Model that extracts memories; empty = the main LLM.
RAG_MEMORY_EXTRACTION_MODEL=
# true | false. Add relevant memories to each query automatically.
RAG_MEMORY_AUTO_INJECT=true
# Memories retrieved per query.
RAG_MEMORY_TOP_K=5
# Past messages included in a reply.
RAG_MAX_CONVERSATION_HISTORY=10
# Tokens of conversation history included.
RAG_CONVERSATION_CONTEXT_BUDGET=2000
# true | false. Title conversations automatically.
RAG_AUTO_TITLE_ENABLED=true
# true | false. New knowledge bases start with the "Customer support" assistant switched on.
RAG_ASSISTANT_DEFAULT_FOR_NEW_KBS=true
# Milliseconds the fast model may take to rewrite a Hindi or Hinglish question for search.
RAG_ASSISTANT_TRANSLATE_TIMEOUT_MS=1500
# Milliseconds the fast model may take to label a message; past it the turn is a business
# question (a reasoning model needs 1.5-2 s at low effort; keep this above that).
RAG_ASSISTANT_LABEL_TIMEOUT_MS=4000
# Seconds a turn label stays cached.
RAG_ASSISTANT_LABEL_CACHE_TTL_S=604800
# Start the answer while the message is still being labelled, once the search has passed its gate; it is sent only when the label agrees, otherwise cancelled (its few tokens are still paid for). Saves the label's wait on most business questions.
RAG_ASSISTANT_SPECULATIVE_ANSWER=true
# Search confidence a grounded answer needs when the knowledge base and the measured defaults set none; empty = at least one passage.
RAG_ASSISTANT_MIN_RETRIEVAL_SCORE=
# Hours a website visitor's chat continues after its last message.
RAG_ASSISTANT_SESSION_TTL_HOURS=24
# Lead form submissions allowed per website visitor per widget key per hour.
RAG_LEAD_RATE_LIMIT_PER_HOUR=5
# When expired leads are deleted (cron syntax, UTC).
RAG_LEAD_RETENTION_SCHEDULE_CRON=30 3 * * *
# Largest CSV export of leads, in rows.
RAG_LEAD_EXPORT_MAX_ROWS=50000
# Local hour (each assistant's business timezone) when the daily lead digest goes out.
RAG_LEAD_DIGEST_HOUR=9
# Talk-to-a-person taps (and callback requests) allowed per website visitor per widget key per hour.
RAG_HANDOFF_RATE_LIMIT_PER_HOUR=20

# Guided setup: pages a crawled website may contribute to the proposal step.
RAG_SETUP_MAX_PAGES=15
# Guided setup: total characters of crawled text the proposal step reads.
RAG_SETUP_MAX_CHARS=60000

# Questions per golden set; bootstrap resamples for confidence intervals; below this many
# questions a result is flagged as too small to trust (conversation C7).
RAG_GOLDEN_SET_MAX_PAIRS=200
RAG_EVAL_BOOTSTRAP_ITERATIONS=1000
RAG_EVAL_MIN_SAMPLES=30

# --- Agentic mode (multi-step reasoning with tools) ---
# Not used yet: the agent loop is built and unit-tested, but no route calls it, so these
# settings change nothing today. Leave it false. true | false.
RAG_ENABLE_AGENTIC_MODE=false
# Most reasoning steps per question.
RAG_AGENT_MAX_ITERATIONS=5
# Token budget per question.
RAG_AGENT_TOKEN_BUDGET=8000
# Seconds per question.
RAG_AGENT_TIMEOUT=30
# Model for the agent; empty = the main LLM.
RAG_AGENT_MODEL=
# Tools the agent may use (comma-separated).
RAG_AGENT_ENABLED_TOOLS=corpus_search,document_fetch,memory_search

# --- Web search ---
# Not used yet: only the agent loop (above) can search the web, and no route calls it, so
# answers never use the web today. serper | brave | off.
RAG_WEB_SEARCH_PROVIDER=off
# Key for that search provider.
RAG_WEB_SEARCH_API_KEY=
# Web results per query.
RAG_WEB_SEARCH_MAX_RESULTS=5

# --- COB, the built-in assistant ---
# true | false. The COB chat panel in the dashboard (chat, history, actions).
RAG_COB_ENABLED=true
# true | false. The docs-only COB on the sign-in pages.
RAG_COB_PUBLIC_ENABLED=true
# Public COB answers per UTC day, for the whole engine.
RAG_COB_PUBLIC_DAILY_LIMIT=500
# Public COB messages per visitor address per hour.
RAG_COB_PUBLIC_PER_IP_PER_HOUR=20
# Days COB keeps a person's chats before the daily cleanup deletes them.
RAG_COB_HISTORY_DAYS=30

# --- Billing ---
# Optional OpenRouter key allowed to read the account credits (Costs page). Empty = the engine key is tried.
RAG_OPENROUTER_MANAGEMENT_KEY=
# Optional OpenAI Admin key: the Costs page shows OpenAI official spend by day. Can also be entered on the page.
RAG_OPENAI_ADMIN_KEY=
# Optional Anthropic Admin key: the Costs page shows Anthropic official spend by day. Can also be entered on the page.
RAG_ANTHROPIC_ADMIN_KEY=
# BIL2
# true | false. Customer billing: prices, wallets and the pause at zero. false = nothing is charged or paused and the billing screens hide.
RAG_BILLING_ENABLED=true
# Seconds between postings of usage charges to the wallet (15-3600).
RAG_BILLING_POST_INTERVAL_SECONDS=60
# When the daily billing reconciliation runs (cron syntax, UTC).
RAG_BILLING_RECONCILE_CRON=30 3 * * *
# /BIL2

# --- Website learning ---
# BIZ1
# true | false. The engine reads a business's own website (only sites it listed as allowed sites of a widget key). false = nothing is read.
RAG_WEBSITE_LEARNING_ENABLED=true
# Name in the User-Agent and for robots.txt rules (letters, digits, dashes).
RAG_WEBSITE_BOT_NAME=CobRagBot
# Most pages learned per workspace, whatever the plan says (1-50000).
RAG_WEBSITE_MAX_PAGES=2000
# How many links deep a site is followed (1-10).
RAG_WEBSITE_MAX_DEPTH=5
# Most URLs looked at in one run (sitemaps and links).
RAG_WEBSITE_MAX_DISCOVERED=20000
# Parallel requests to one site (1-8).
RAG_WEBSITE_CONCURRENCY=2
# Pause between two requests to one site, in milliseconds (a robots.txt crawl-delay wins, up to 10 s).
RAG_WEBSITE_REQUEST_DELAY_MS=500
# Seconds allowed for one page, redirects included.
RAG_WEBSITE_TIMEOUT_SECONDS=20
# Largest page or sitemap that is read, in bytes.
RAG_WEBSITE_MAX_RESPONSE_BYTES=5242880
# true | false. Lets the engine read private addresses (an intranet). Leave false on the internet.
RAG_WEBSITE_ALLOW_PRIVATE_NETWORKS=false
# The scraper's address, used to read pages that need a browser. Empty = off. Native runs use http://127.0.0.1:8001.
RAG_WEBSITE_RENDER_URL=http://scraper:8001
# Shared secret with the scraper's render endpoint (generated by scripts/generate_secrets.py). Empty = off.
RAG_WEBSITE_RENDER_TOKEN=
# Seconds between runs of the freshness scheduler (60-3600).
RAG_WEBSITE_CHECK_INTERVAL_SECONDS=300
# Pushed page addresses accepted per push key per minute.
RAG_WEBSITE_PUSH_PER_MINUTE=60
# Pushed page addresses accepted per push key per day.
RAG_WEBSITE_PUSH_PER_DAY=2000
# Share of page views (0-1) on which the website widget reports that a page changed.
RAG_WEBSITE_SENSOR_SAMPLE=0.2
# Least seconds between two widget-triggered checks of the same page.
RAG_WEBSITE_SENSOR_MIN_INTERVAL_SECONDS=1800
# /BIZ1
# BIZ4
# Largest assistant picture a business can upload, in bytes (it is re-saved as a 256x256 PNG).
RAG_AVATAR_MAX_BYTES=1048576
# /BIZ4

# --- Answer lanes ---
# PIP1
# Key for the hosted reranking service (Cohere, Jina, Voyage) that a pipeline profile with the "api" re-ranker uses. Empty = such a profile re-ranks on this server instead.
RAG_RERANK_API_KEY=
# Answers the engine writes at once, across all its processes. 0 = no engine-wide queue. Set it to what your AI provider and server can take, so a rush of free questions never slows paying ones.
RAG_ANSWER_SLOTS=0
# Slots kept free for high-priority (Premium) answers.
RAG_ANSWER_SLOTS_RESERVED_HIGH=1
# Most slots low-priority (Economy) answers may use. 0 = half of them.
RAG_ANSWER_SLOTS_LOW_MAX=0
# Seconds a question waits for a free slot before the visitor gets the polite "very busy" reply (1-120).
RAG_ANSWER_QUEUE_MAX_WAIT_SECONDS=20
# A held slot is released on its own after this many seconds if its process died (30-900).
RAG_ANSWER_LEASE_SECONDS=180
# /PIP1

# --- Fair use ---
# PIP3
# Check each business's fair-use limits (questions per hour and day, website reads, uploads, AI spend). false = only the monthly question cap and billing apply.
RAG_FAIR_USE_ENABLED=true
# Seconds the background write that sends fair-use alerts and counts decisions may take (1-120).
RAG_FAIR_USE_ALERT_TASK_TIMEOUT_SECONDS=10
# /PIP3

# --- Local model ---
# PIP2
# Free answers on this server's own CPU. Slower (often 10-40 seconds), no AI bill. Also add local-llm to COMPOSE_PROFILES. The scripts/setup.py wizard sets both.
RAG_LOCAL_LLM_ENABLED=false
# Where the engine reaches the local model from this machine. Containers use RAG_LOCAL_LLM_URL_CONTAINER.
RAG_LOCAL_LLM_URL=http://127.0.0.1:11434
RAG_LOCAL_LLM_URL_CONTAINER=http://local-llm:11434
# The model downloaded once at first start and used for free answers. Needs about 6 GB of free memory for a 4-billion-parameter model.
RAG_LOCAL_LLM_MODEL=gemma3:4b
# Answers the local model writes at once. One keeps the rest of the engine responsive on a small server. Every one of them is usable by free (low priority) answers: RAG_ANSWER_SLOTS_RESERVED_HIGH and RAG_ANSWER_SLOTS_LOW_MAX apply to the engine pool only.
RAG_LOCAL_LLM_SLOTS=1
# Context window given to the local model (more = more memory).
RAG_LOCAL_LLM_NUM_CTX=8192
# Seconds one local answer may take before it is given up.
RAG_LOCAL_LLM_TIMEOUT_SECONDS=300
# How long the model stays loaded in memory between questions.
RAG_LOCAL_LLM_KEEP_ALIVE=24h
# Port the local-llm service is published on (bound to RAG_BIND_ADDR).
RAG_LOCAL_LLM_HOST_PORT=11434
# The service image (pinned on purpose: a new release can change what fits in memory).
# RAG_LOCAL_LLM_IMAGE=ollama/ollama:0.12.6
# /PIP2

# --- WhatsApp ---
# TV6
# Let businesses connect their WhatsApp number. Needs your own Meta app (see docs/deploy.html, "Connect WhatsApp").
RAG_WHATSAPP_ENABLED=false
# Your Meta app id and secret (the secret also checks that webhook calls really come from Meta).
RAG_WHATSAPP_APP_ID=
RAG_WHATSAPP_APP_SECRET=
# A word you choose; paste the same one into the Meta app's webhook settings.
RAG_WHATSAPP_VERIFY_TOKEN=
# The Embedded Signup configuration id from the Meta app (lets a business connect itself).
RAG_WHATSAPP_CONFIG_ID=
# Meta's Graph API address and version. Change the version when Meta retires the old one.
RAG_WHATSAPP_GRAPH_URL=https://graph.facebook.com
RAG_WHATSAPP_GRAPH_VERSION=v23.0
# Hours the assistant stays quiet in a chat after the business replies there (1-72).
RAG_WHATSAPP_HUMAN_PAUSE_HOURS=12
# /TV6

# --- Payments ---
# P1 payments
# Online payments through Razorpay. Leave all four empty and use Admin > Billing > Payments in the dashboard
# instead (keys saved there are stored encrypted). A value set here wins over the dashboard.
# razorpay | none. Empty = follow the dashboard setting.
RAG_PAYMENTS_PROVIDER=
# Your Razorpay key id (rzp_test_... while testing, rzp_live_... for real money).
RAG_RAZORPAY_KEY_ID=
# Your Razorpay key secret.
RAG_RAZORPAY_KEY_SECRET=
# The secret you typed in Razorpay's webhook settings.
RAG_RAZORPAY_WEBHOOK_SECRET=
# /P1 payments

# --- Demo mode ---
# L5a demo
# Demo mode (a public demo server only; leave off). It turns the install into a demo anyone can sign in to:
# deleting, keys, e-mail, WhatsApp, plans and passwords are switched off, nothing is sent
# out, model use has a daily ceiling, and everything is put back every night.
RAG_DEMO_MODE=false
# The password of BOTH demo sign-ins. WARNING: the sign-in page shows it to every visitor, so never reuse a real one.
RAG_DEMO_PASSWORD=
# The demo business owner's sign-in address (the platform owner's is RAG_SUPERADMIN_EMAIL). Must be a different address.
RAG_DEMO_OWNER_EMAIL=
# When the demo puts itself back to the seed each night, HH:MM in UTC (21:30 UTC is 03:00 in India).
RAG_DEMO_RESET_AT_UTC=21:30
# The demo's day starts at RAG_DEMO_RESET_AT_UTC: every counter below starts again then.
# The most answers the whole demo may give in one day (1 to 100000). Small talk, cached answers and requests
# for a person are free and not counted. When it is used up, everyone sees a polite "try tomorrow".
RAG_DEMO_ANSWERS_PER_DAY=300
# The most answers one visitor may get in one day (1 to 100000). A visitor is a keyed hash of the client IP
# (plus the signed-in user), never stored raw; people behind one office address share this quota.
RAG_DEMO_ANSWERS_PER_VISITOR_PER_DAY=15
# The most model calls the demo may make in one day (1 to 100000). A hard stop under the answer limits (one
# answer is about four calls: label, rewrite, answer, fact check), for paths the answer limits do not see.
RAG_DEMO_MODEL_CALLS_PER_DAY=1200
# Which sites may show the dashboard inside a frame. Leave empty: only the dashboard's own address may.
# A demo shown on another site uses: self https://demo.example.com
# (write self and none without quotes; every other item is https://the-site)
RAG_FRAME_ANCESTORS=
# /L5a demo
